{
  "domain": "jackery_navi",
  "name": "Jackery Navi 2000 (local Bluetooth)",
  "bluetooth": [
    {
      "local_name": "Jackery_HA*",
      "connectable": true
    }
  ],
  "codeowners": ["@longsleep"],
  "config_flow": true,
  "dependencies": ["bluetooth_adapters"],
